# ==============================================================================
# NICU 3D Visualization Module - Firebase Configuration Template
# ==============================================================================
# Copy this file to `.env` or set these in your local environment.
# These values must be provided by your Firebase/Backend teammate.
# DO NOT COMMIT REAL API KEYS TO VERSION CONTROL.
#
# If left empty, the application runs in Standby Mock Mode with zero errors.
# ==============================================================================

# Firebase Project Credentials
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Target Telemetry Database Path
# The 3D visualization will listen to this path for incoming JSON packets:
VITE_FIREBASE_DB_PATH=nicu/live_monitoring
